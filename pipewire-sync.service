[Unit]
Description=EVO8 PipeWire volume sync
After=graphical-session.target pipewire-pulse.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python /home/hans/dev/audient-evo/pipewire_sync.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
